NODE_ENV=development
PORT=3001
HOST=0.0.0.0

# CORS (vírgula para múltiplas origens, * para todas)
CORS_ORIGIN=*

# Rate limit
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# Opcional: exige header X-API-Key quando definido
# API_KEY=seu-token-secreto

# WhatsApp
AUTH_STATE_PATH=storage/auth
WELCOME_MESSAGE=Olá! 👋 Obrigado por entrar em contato. Em breve retornaremos.
WELCOME_COOLDOWN_HOURS=6

# Reconexão
RECONNECT_MAX_ATTEMPTS=10
RECONNECT_DELAY_MS=3000
